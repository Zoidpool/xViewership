# Copy to .env (git-ignored). Without any of these the app uses template narration.

# Option A (free, on-device): Microsoft Foundry Local. Install with
#   winget install Microsoft.FoundryLocal
# then name a chat model alias from `foundry model list`.
FOUNDRY_LOCAL_MODEL=qwen2.5-7b

# Option B (Azure): Microsoft Foundry project + model deployment.
# FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL=<deployment-name>
# FOUNDRY_AUTH=browser   # one interactive sign-in; empty = DefaultAzureCredential
# AZURE_TENANT_ID=
